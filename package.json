{
  "name": "personal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "build/desktop/main.js",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "postinstall": "node scripts/setup-terminal.mjs",
    "setup:terminal": "node scripts/setup-terminal.mjs",
    "diagnose": "node --disable-warning=ExperimentalWarning scripts/doctor.mjs",
    "baseline:platform": "node --disable-warning=ExperimentalWarning scripts/baseline-platform.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=tap tests/*.test.ts",
    "test:contracts": "python3 docs/design/contracts/validate_contracts.py",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "protocol:verify": "node scripts/generate-protocol.mjs --verify",
    "smoke:codex": "node --disable-warning=ExperimentalWarning scripts/smoke-codex.ts",
    "smoke:connection": "node --disable-warning=ExperimentalWarning scripts/probe-codex.ts",
    "smoke:worktree-recovery:desktop": "node scripts/smoke-desktop.mjs --worktree-recovery",
    "smoke:tools:desktop": "node scripts/smoke-desktop.mjs --tools",
    "smoke:backups:desktop": "node scripts/smoke-desktop.mjs --backups",
    "smoke:restore:preflight": "node scripts/smoke-restore.mjs --preflight",
    "smoke:restore:desktop": "node scripts/smoke-restore.mjs",
    "smoke:rehearsal:desktop": "node scripts/smoke-desktop.mjs --rehearsal",
    "smoke:resources:desktop": "node scripts/smoke-desktop.mjs --resources",
    "smoke:main-chat:desktop": "node scripts/smoke-desktop.mjs --main-chat",
    "smoke:skills:desktop": "node scripts/smoke-desktop.mjs --skills",
    "smoke:skills:native": "node --disable-warning=ExperimentalWarning scripts/probe-project-skills.ts",
    "smoke:worktree-code:preflight": "node scripts/smoke-desktop.mjs --worktree-code-preflight",
    "smoke:worktree-code:desktop": "node scripts/smoke-desktop.mjs --worktree-code",
    "smoke:terminal:desktop": "node scripts/smoke-desktop.mjs --terminal",
    "smoke:worktrees:desktop": "node scripts/smoke-desktop.mjs --worktrees",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "smoke:history:local": "node --disable-warning=ExperimentalWarning scripts/probe-history.ts",
    "smoke:history:desktop": "node scripts/smoke-desktop.mjs --history",
    "smoke:code:desktop": "node scripts/smoke-desktop.mjs --native-code",
    "smoke:code:continue:desktop": "node scripts/smoke-desktop.mjs --native-code-continue",
    "smoke:owner:desktop": "node --disable-warning=ExperimentalWarning scripts/smoke-native-desktop.mjs --owner",
    "smoke:folder:desktop": "node --disable-warning=ExperimentalWarning scripts/smoke-native-desktop.mjs --folder",
    "smoke:verification": "node --disable-warning=ExperimentalWarning scripts/smoke-verification.ts",
    "smoke:workspace": "node --disable-warning=ExperimentalWarning scripts/smoke-workspace.ts",
    "smoke:workspace:desktop": "node --disable-warning=ExperimentalWarning scripts/smoke-native-desktop.mjs --workspace",
    "smoke:plans:desktop": "node scripts/smoke-desktop.mjs --plans",
    "smoke:background:desktop": "node scripts/smoke-desktop.mjs --background",
    "smoke:background:native": "node scripts/smoke-desktop.mjs --background-native",
    "smoke:scheduled:desktop": "node scripts/smoke-desktop.mjs --scheduler-auto",
    "smoke:scheduled": "node --disable-warning=ExperimentalWarning scripts/smoke-scheduled.ts",
    "smoke:scheduler:desktop": "node scripts/smoke-desktop.mjs --scheduler",
    "probe:calendar": "node --disable-warning=ExperimentalWarning scripts/probe-calendar.ts",
    "smoke:tasks:desktop": "node scripts/smoke-desktop.mjs --tasks",
    "smoke:budget": "node --disable-warning=ExperimentalWarning scripts/smoke-budget.ts",
    "smoke:budget:desktop": "node scripts/smoke-desktop.mjs --budget",
    "smoke:continuation:desktop": "node scripts/smoke-desktop.mjs --continuation",
    "smoke:interactions:desktop": "node scripts/smoke-desktop.mjs --interactions",
    "smoke:execution:desktop": "node scripts/smoke-desktop.mjs --execution",
    "smoke:execution": "node --disable-warning=ExperimentalWarning scripts/smoke-execution.ts",
    "setup:headless": "node scripts/setup-headless.mjs",
    "check": "node scripts/check.mjs",
    "smoke:autonomy:desktop": "node scripts/smoke-desktop.mjs --autonomy"
  },
  "dependencies": {
    "@xterm/xterm": "6.0.0",
    "cron-parser": "5.10.3",
    "js-tiktoken": "1.0.21",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
