{
  "name": "personal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "build/desktop/main.js",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=ExperimentalWarning --test --test-reporter=tap tests/*.test.ts",
    "test:contracts": "python3 docs/design/contracts/validate_contracts.py",
    "protocol:generate": "node scripts/generate-protocol.mjs",
    "protocol:verify": "node scripts/generate-protocol.mjs --verify",
    "smoke:codex": "node --disable-warning=ExperimentalWarning scripts/smoke-codex.ts",
    "smoke:connection": "node --disable-warning=ExperimentalWarning scripts/probe-codex.ts",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "smoke:history:local": "node --disable-warning=ExperimentalWarning scripts/probe-history.ts",
    "smoke:history:desktop": "node scripts/smoke-desktop.mjs --history",
    "smoke:interactions:desktop": "node scripts/smoke-desktop.mjs --interactions",
    "smoke:execution:desktop": "node scripts/smoke-desktop.mjs --execution",
    "smoke:execution": "node --disable-warning=ExperimentalWarning scripts/smoke-execution.ts",
    "setup:headless": "node scripts/setup-headless.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.2.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
